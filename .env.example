APP_NAME=manufacturing-dss
ENVIRONMENT=development
MES_DATABASE_PATH=data/raw/MES.db
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
# Approval API authentication
APPROVAL_AUTH_ENABLED=true
# Format: key:identity:role; comma-separated entries
# Use generated secrets in the local .env only.
APPROVAL_API_KEYS=
APPROVAL_DATABASE_PATH=data/processed/approvals.db
APPROVAL_SUPERVISOR_ID=123